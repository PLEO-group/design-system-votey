{
  "$schema": "./schemas/design-system.schema.json",
  "schemaVersion": 1,
  "kind": "pleo-design-system",
  "identity": {
    "product": "example",
    "packageName": "@pleodigital/design-system-example",
    "version": "1.0.0",
    "registry": {
      "type": "npmjs",
      "access": "public",
      "url": "https://registry.npmjs.org/"
    }
  },
  "designSource": {
    "type": "figma",
    "projectUrl": "https://www.figma.com/design/replace-whole-design-system-project",
    "exceptionReason": null
  },
  "repository": {
    "topology": "colocated-workspace-package",
    "packageRoot": "packages/design-system-example",
    "consumerRoots": ["apps/example-app"],
    "boundaryPolicy": {
      "publicImportsOnly": true,
      "packageImportsConsumer": false,
      "packCheck": true,
      "forbiddenPackageImportPrefixes": ["@app/", "src/app/"],
      "localMiniDs": {
        "mode": "forbid",
        "baselineFile": null,
        "heuristicFindings": "block",
        "justification": null
      }
    }
  },
  "distribution": {
    "mode": "workspace-internal",
    "publishable": false
  },
  "frameworks": {
    "angular": {
      "enabled": true,
      "entryPoint": "./angular"
    },
    "react": {
      "enabled": true,
      "entryPoint": "./react"
    }
  },
  "tokens": {
    "sourceOfTruth": {
      "type": "figma-variables",
      "url": "https://www.figma.com/design/replace-me"
    },
    "generator": "style-dictionary",
    "namingContract": "pleo-design-system-tokens-v1",
    "categories": {
      "color": {
        "generate": ["core", "semantic"],
        "autocomplete": ["semantic"],
        "allowedUsage": ["semantic"]
      },
      "spacing": {
        "generate": ["core", "semantic"],
        "autocomplete": ["core", "semantic"],
        "allowedUsage": ["core", "semantic"]
      },
      "typography": {
        "generate": ["core", "semantic"],
        "autocomplete": ["core", "semantic"],
        "allowedUsage": ["core", "semantic"]
      },
      "radius": {
        "generate": ["core", "semantic"],
        "autocomplete": ["core", "semantic"],
        "allowedUsage": ["core", "semantic"]
      },
      "opacity": {
        "generate": ["core", "semantic"],
        "autocomplete": ["core", "semantic"],
        "allowedUsage": ["core", "semantic"]
      }
    },
    "frameworkPolicies": {
      "angular": {
        "categories": {},
        "outputs": ["scss", "css-variables"]
      },
      "react": {
        "categories": {},
        "outputs": ["scss", "tailwind"]
      }
    }
  },
  "themes": {
    "modes": ["light", "dark"],
    "semanticTokenFiles": {
      "light": "tokens/semantic/light/theme.json",
      "dark": "tokens/semantic/dark/theme.json"
    },
    "angular": {
      "enabled": true,
      "host": "body",
      "attribute": "data-theme",
      "storage": "session",
      "storageKey": "theme",
      "defaultTheme": "light",
      "initialThemeInHtml": "light",
      "initialization": "explicit-load",
      "useViewTransitions": true,
      "servicePath": "angular/src/lib/theme.service.ts",
      "contractScssPath": "src/styles/theming/theme-contract.scss"
    }
  },
  "artifacts": {
    "policy": "build-only",
    "sources": ["tokens/**", "assets/icons/**", "assets/illustrations/**", "svg-assets.config.json", "scripts/generate-svg-assets.mjs"],
    "generated": ["angular/src/lib/design-system-assets.generated.ts", "src/styles/responsive/_responsive-config.generated.scss", "dist/**"],
    "cleanBeforeBuild": true,
    "verifyDeterminism": true
  },
  "assets": {
    "namingContract": "pleo-design-system-assets-v1",
    "iconsPath": "assets/icons",
    "illustrationsPath": "assets/illustrations",
    "angularSvgRegistry": true,
    "generatorPath": "scripts/generate-svg-assets.mjs",
    "configPath": "svg-assets.config.json",
    "generatedTypesPath": "angular/src/lib/design-system-assets.generated.ts",
    "reactBarrelPath": "dist/assets/react/index.ts"
  },
  "responsive": {
    "mode": "device-contract",
    "generatedConfigScssPath": "src/styles/responsive/_responsive-config.generated.scss",
    "deviceTypes": ["mobile", "tablet", "desktop"],
    "deviceBreakpointMap": {
      "mobile": "mobile",
      "tablet": "tablet",
      "desktop": "desktop"
    },
    "breakpoints": {
      "names": ["mobile-small", "mobile", "tablet-small", "tablet", "laptop", "desktop"],
      "tokenFile": "tokens/core/breakpoints.json",
      "tokenPath": "breakpoint.core"
    },
    "scaling": {
      "enabled": true,
      "deviceMultipliers": {
        "mobile": 0.8,
        "tablet": 1.2,
        "desktop": 1
      },
      "implicitBreakpointFallbacks": {
        "mobile-small": "mobile",
        "tablet-small": "tablet",
        "laptop": "desktop"
      }
    },
    "grid": {
      "enabled": true,
      "variants": ["default"],
      "defaultVariant": "default",
      "tokenFile": "tokens/core/grid.json",
      "tokenPath": "grid.core"
    }
  },
  "preview": {
    "type": "storybook",
    "command": "npm run build-storybook"
  },
  "commands": {
    "buildTokens": "npm run build:tokens",
    "buildAssets": "npm run build:assets",
    "checkAssets": "npm run check:assets",
    "build": "npm run build",
    "test": "npm test",
    "pack": "npm pack --dry-run",
    "publish": null
  },
  "ci": {
    "providers": ["github-actions"]
  },
  "designSystemSkill": {
    "name": "example-design-system",
    "sourcePath": "skills/example-design-system",
    "verifiedPackageVersion": "1.0.0",
    "companyStandardContracts": [
      { "id": "repository-boundary", "version": "1.0.0" },
      { "id": "foundation-tokens", "version": "1.0.0" },
      { "id": "semantic-theming", "version": "1.0.0" },
      { "id": "svg-assets-source-driven", "version": "1.0.0" },
      { "id": "responsive-device", "version": "1.0.0" },
      { "id": "grid-layout", "version": "1.0.0" },
      { "id": "component-authoring", "version": "1.0.0" },
      { "id": "preview-documentation", "version": "1.0.0" },
      { "id": "consumer-integration", "version": "1.0.0" },
      { "id": "framework-isolation", "version": "1.0.0" }
    ]
  },
  "exceptions": []
}

